# MediaFlow Application Configuration

# Application Environment (development, production)
APP_ENV=development
APP_LOG_LEVEL=INFO

# Storage
MEDIAFLOW_DOWNLOAD_DIR=downloads
MEDIAFLOW_TEMP_DIR=downloads/.temp

# Concurrency
MEDIAFLOW_MAX_CONCURRENT_DOWNLOADS=3

# Database
MEDIAFLOW_DB_PATH=mediaflow.db

# FFmpeg Executable Path (leave empty to use system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
